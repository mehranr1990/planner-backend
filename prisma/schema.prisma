generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth scalar fields generated by auth@1.7.14 from authSchemaOptions.
model User {
  id                  String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                String
  email               String
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  authsessions        AuthSession[]
  authaccounts        AuthAccount[]
  settings            UserSettings?
  spaces              Space[]
  securityAuditEvents SecurityAuditEvent[]

  @@unique([email])
  @@map("User")
}

model AuthSession {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("AuthAccount")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AuthVerification")
}

// Application-owned models. No business-domain or future batch tables.
model UserSettings {
  userId            String   @id @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale            String   @default("en")
  timezone          String   @default("UTC")
  preferredCalendar String   @default("GREGORIAN")
  firstDayOfWeek    Int      @default(1)
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum SpaceKind {
  PERSONAL
}

model Space {
  id                 String              @id @default(uuid()) @db.Uuid
  kind               SpaceKind           @default(PERSONAL)
  ownerUserId        String              @db.Uuid
  owner              User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outboxEvents       OutboxEvent[]
  idempotencyRecords IdempotencyRecord[]
  storedFiles        StoredFile[]

  @@unique([kind, ownerUserId])
  @@unique([id, ownerUserId])
}

// Platform evidence: deliberately contains no email, IP, token, URL or arbitrary JSON.
enum AuditOutcome {
  ATTEMPTED
  SUCCEEDED
  DENIED
  FAILED
}

model SecurityAuditEvent {
  id            String       @id @default(uuid()) @db.Uuid
  action        String       @db.VarChar(40)
  outcome       AuditOutcome
  actorUserId   String?      @db.Uuid
  actor         User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  requestId     String       @db.Uuid
  correlationId String       @db.Uuid
  resourceId    String?      @db.Uuid
  changedFields String[]     @default([])
  occurredAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, occurredAt, id])
  @@index([requestId])
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   @db.VarChar(100)
  version       Int
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  aggregateId   String   @db.Uuid
  spaceId       String   @db.Uuid
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payload       Json     @db.JsonB
  correlationId String   @db.Uuid

  @@index([spaceId, occurredAt, id])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  spaceId     String   @db.Uuid
  space       Space    @relation(fields: [spaceId, actorUserId], references: [id, ownerUserId], onDelete: Cascade)
  operation   String   @db.VarChar(80)
  keyHash     String   @db.Char(64)
  fingerprint String   @db.Char(64)
  resultId    String   @db.Uuid
  statusCode  Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([actorUserId, spaceId, operation, keyHash])
  @@index([expiresAt])
}

enum StoredFileStatus {
  INITIATED
  READY
  REJECTED
  DELETED
}

model StoredFile {
  id              String           @id @default(uuid()) @db.Uuid
  spaceId         String           @db.Uuid
  ownerUserId     String           @db.Uuid
  space           Space            @relation(fields: [spaceId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  objectKey       String           @unique @db.Uuid
  filename        String           @db.VarChar(180)
  mimeType        String           @db.VarChar(100)
  expectedSize    Int
  expectedSha256  String?          @db.Char(64)
  actualSize      Int?
  sha256          String?          @db.Char(64)
  status          StoredFileStatus @default(INITIATED)
  revision        Int              @default(1)
  uploadAttemptId String?          @db.Uuid
  uploadStartedAt DateTime?        @db.Timestamptz(3)
  uploadExpiresAt DateTime         @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  purgedAt        DateTime?        @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, status, createdAt, id])
}
