 version AnnouncementVersion @relation("AnnouncementVersionAttachment_version_fk",fields:[announcementId,versionId],references:[announcementId,id],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementVersionAttachment_version_fk")
 announcementId String @db.Uuid
 versionId String @db.Uuid
 attachmentId String @db.Uuid
 @@id([versionId,attachmentId])
}

// P5-05 / ADR 0048: typed meeting and publication owner data.
model AnnouncementAcknowledgement {
 actor SharedActor @relation("AnnouncementAcknowledgement_actor_fk",fields:[spaceId,actorId],references:[spaceId,id],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementAcknowledgement_actor_fk")
 target AnnouncementTarget @relation("AnnouncementAcknowledgement_target_fk",fields:[versionId,accessId,generation],references:[versionId,accessId,generation],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementAcknowledgement_target_fk")
 versionId String @db.Uuid
 accessId String @db.Uuid
 generation Int
 actorId String @db.Uuid
 spaceId String @db.Uuid
 createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
 @@id([versionId,accessId])
}

// P5-05 / ADR 0048: typed meeting and publication owner data.
model AnnouncementMutation {
 interval ContextAccessInterval @relation("AnnouncementMutation_interval_fk",fields:[accessId,generation],references:[accessId,generation],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementMutation_interval_fk")
 actor SharedActor @relation("AnnouncementMutation_actor_fk",fields:[spaceId,actorId],references:[spaceId,id],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementMutation_actor_fk")
 announcement Announcement @relation("AnnouncementMutation_announcement_fk",fields:[announcementId],references:[id],onDelete:NoAction,onUpdate:NoAction,map:"AnnouncementMutation_announcement_fk")
 announcementId String @db.Uuid
 actorId String @db.Uuid
 spaceId String @db.Uuid
 accessId String @db.Uuid
 generation Int
 keyHash String @db.Char(64)
 fingerprint String @db.Char(64)
 resourceId String @db.Uuid
 action String @db.VarChar(40)
 @@id([announcementId,actorId,generation,keyHash])
}

model DmContactState {
 spaceId String @id @db.Uuid
 ownerUserId String @unique @db.Uuid
 version BigInt @default(0)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 owner Space @relation("DmContactState_owner_fk",fields:[spaceId,ownerUserId],references:[id,ownerUserId],onDelete:Cascade,onUpdate:NoAction)
 blocks DmContactBlock[]
 mutations DmContactMutation[]
 @@unique([spaceId,ownerUserId])
}
model DmContactBlock {
  restrictedAt DateTime? @db.Timestamptz(3)
 id String @id @db.Uuid
 spaceId String @db.Uuid
 ownerUserId String @db.Uuid
 targetUserId String @db.Uuid
 sourceConversationId String? @db.Uuid
 active Boolean
 revision Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 owner DmContactState @relation(fields:[spaceId,ownerUserId],references:[spaceId,ownerUserId],onDelete:Cascade,onUpdate:NoAction,map:"DmContactBlock_owner_fk")
 target User @relation("DmContactBlock_target_fk",fields:[targetUserId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 source Conversation? @relation("DmContactBlock_source_fk",fields:[sourceConversationId],references:[id],onDelete:SetNull,onUpdate:NoAction)
 mutations DmContactMutation[]
 @@unique([spaceId,targetUserId])
 @@index([targetUserId,active])
}
model DmContactMutation {
 id String @id @db.Uuid
 spaceId String @db.Uuid
 ownerUserId String @db.Uuid
 blockId String? @db.Uuid
 keyHash String @db.Char(64)
 fingerprint String @db.Char(64)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 owner DmContactState @relation(fields:[spaceId,ownerUserId],references:[spaceId,ownerUserId],onDelete:Cascade,onUpdate:NoAction,map:"DmContactMutation_owner_fk")
 block DmContactBlock? @relation(fields:[blockId],references:[id],onDelete:SetNull,onUpdate:NoAction,map:"DmContactMutation_block_fk")
 @@unique([spaceId,keyHash])
}
