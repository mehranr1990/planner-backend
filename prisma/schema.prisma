generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth scalar fields generated by auth@1.7.14 from authSchemaOptions.
model User {
  ContextInvitation   ContextInvitation[]
  sharedActors        SharedActor[]
  id                  String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                String
  email               String
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  authsessions        AuthSession[]
  authaccounts        AuthAccount[]
  settings            UserSettings?
  spaces              Space[]
  securityAuditEvents SecurityAuditEvent[]
  createdTasks        Task[]               @relation("TaskCreator")
  taskChanges         TaskChange[]         @relation("TaskActor")

  @@unique([email])
  @@map("User")
}

model AuthSession {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("AuthAccount")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AuthVerification")
}

// Application-owned account foundation; business models are added only in their approved batches.
model UserSettings {
  rewardsEnabled             Boolean   @default(false)
  rewardsEnabledSince        DateTime? @db.Timestamptz(3)
  rewardsDisplayAchievements Boolean   @default(true)
  userId                     String    @id @db.Uuid
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale                     String    @default("en")
  timezone                   String    @default("UTC")
  preferredCalendar          String    @default("GREGORIAN")
  firstDayOfWeek             Int       @default(1)
  planningAvailability       Json?     @db.JsonB
  revision                   Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

enum SpaceKind {
  PERSONAL
  SHARED
}

model Space {
  sharedCustody           SharedCustody?
  accessClosedAt          DateTime?                @db.Timestamptz(3)
  syncSequence            BigInt                   @default(0)
  syncRetainedSequence    BigInt                   @default(0)
  syncEpoch               String                   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncChanges             SyncChange[]
  exportJobs              UserExportJob[]
  syncReceipts            SyncMutationReceipt[]
  xpLedger                XpLedger[]
  achievementUnlocks      AchievementUnlock[]
  reminders               Reminder[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  financialAccounts       FinancialAccount[]
  financeCategories       FinanceCategory[]
  transactions            Transaction[]
  transactionPostings     TransactionPosting[]
  budgets                 Budget[]
  budgetPeriods           BudgetPeriod[]
  bills                   Bill[]
  savingsGoals            SavingsGoal[]
  exchangeRates           ExchangeRateSnapshot[]
  notes                   Note[]
  noteFolders             NoteFolder[]
  journalEntries          JournalEntry[]
  moodEntries             MoodEntry[]
  captureItems            CaptureItem[]
  focusSessions           FocusSession[]
  timeEntries             TimeEntry[]
  id                      String                   @id @default(uuid()) @db.Uuid
  kind                    SpaceKind                @default(PERSONAL)
  ownerUserId             String?                  @db.Uuid
  owner                   User?                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  outboxEvents            OutboxEvent[]
  idempotencyRecords      IdempotencyRecord[]
  storedFiles             StoredFile[]
  tasks                   Task[]
  labels                  Label[]
  taskTemplates           TaskTemplate[]
  savedTaskFilters        SavedTaskFilter[]
  taskRecurrences         TaskRecurrence[]
  dailyPlans              DailyPlan[]
  weeklyPlans             WeeklyPlan[]
  planningReviews         PlanningReview[]
  calendarEvents          CalendarEvent[]
  eventRecurrences        EventRecurrence[]
  timeBlocks              TimeBlock[]
  habits                  Habit[]
  habitEntryActors        HabitEntry[]
  routines                Routine[]
  lifeAreas               LifeArea[]
  goals                   Goal[]

  Goal_Goal_spaceIdToSpace Goal[] @relation("Goal_spaceIdToSpace")

  TimeBlockSharedTaskLink TimeBlockSharedTaskLink[]

  @@unique([kind, ownerUserId])
  @@unique([id, ownerUserId])

  StoredFile_StoredFile_spaceIdToSpace StoredFile[]              @relation("StoredFile_spaceIdToSpace")

  ProjectTransfer                      ProjectTransfer[]
}

// Platform evidence: deliberately contains no email, IP, token, URL or arbitrary JSON.
enum AuditOutcome {
  ATTEMPTED
  SUCCEEDED
  DENIED
  FAILED
}

model SecurityAuditEvent {
  productivityFields String[]     @default([])
  id                 String       @id @default(uuid()) @db.Uuid
  action             String       @db.VarChar(40)
  outcome            AuditOutcome
  actorUserId        String?      @db.Uuid
  actor              User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  requestId          String       @db.Uuid
  correlationId      String       @db.Uuid
  resourceId         String?      @db.Uuid
  changedFields      String[]     @default([])
  occurredAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, occurredAt, id])
  @@index([requestId])
}

model OutboxEvent {
  habitEntry              HabitEntry?
  rewardHandledAt         DateTime?   @db.Timestamptz(3)
  rewardAttempts          Int         @default(0)
  rewardRetryAt           DateTime?   @db.Timestamptz(3)
  rewardFailureCode       String?     @db.VarChar(80)
  reward                  XpLedger?
  notificationHandledAt   DateTime?   @db.Timestamptz(3)
  notificationAttempts    Int         @default(0)
  notificationRetryAt     DateTime?   @db.Timestamptz(3)
  notificationFailureCode String?     @db.VarChar(80)
  id                      String      @id @default(uuid()) @db.Uuid
  type                    String      @db.VarChar(100)
  version                 Int
  occurredAt              DateTime    @default(now()) @db.Timestamptz(3)
  aggregateId             String      @db.Uuid
  spaceId                 String      @db.Uuid
  space                   Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payload                 Json        @db.JsonB
  correlationId           String      @db.Uuid

  @@unique([spaceId, id])
  @@index([spaceId, occurredAt, id])
}

model AchievementDefinition {
  id          String              @id @db.Uuid
  code        String              @unique @db.VarChar(40)
  ruleVersion Int                 @default(1)
  kind        String              @db.VarChar(20)
  required    Int
  unlocks     AchievementUnlock[]
}

model UserExportJob {
  id           String    @id @default(uuid()) @db.Uuid
  ownerUserId  String    @db.Uuid
  spaceId      String    @db.Uuid
  space        Space     @relation(fields: [spaceId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade, onUpdate: NoAction)
  revision     Int       @default(1)
  state        String    @default("QUEUED") @db.VarChar(20)
  attempts     Int       @default(0)
  leaseUntil   DateTime? @db.Timestamptz(3)
  nextAt       DateTime  @default(now()) @db.Timestamptz(3)
  objectKey    String    @default(uuid()) @db.Uuid
  artifactKeys String[]  @default([]) @db.Uuid
  attemptKey   String    @default(uuid()) @db.Uuid
  artifactSize Int?
  artifactHash String?   @db.Char(64)
  manifest     Json?     @db.JsonB
  failureCode  String?   @db.VarChar(80)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  expiresAt    DateTime? @db.Timestamptz(3)

  @@index([ownerUserId, createdAt, id])
  @@index([state, nextAt, id])
}

model AccountDeletionJob {
  id                    String    @id @default(uuid()) @db.Uuid
  ownerUserId           String?   @db.Uuid
  spaceId               String?   @db.Uuid
  identityDigest        String    @db.Char(64)
  spaceDigest           String    @db.Char(64)
  revision              Int       @default(1)
  state                 String    @default("PENDING") @db.VarChar(20)
  confirmationHash      String?   @db.Char(64)
  recoveryHash          String?   @db.Char(64)
  confirmationExpiresAt DateTime? @db.Timestamptz(3)
  recoveryExpiresAt     DateTime? @db.Timestamptz(3)
  policyVersion         String    @db.VarChar(80)
  retentionAcknowledged Boolean   @default(false)
  attempts              Int       @default(0)
  leaseUntil            DateTime? @db.Timestamptz(3)
  nextAt                DateTime  @default(now()) @db.Timestamptz(3)
  progress              Json?     @db.JsonB
  failureCode           String?   @db.VarChar(80)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  confirmedAt           DateTime? @db.Timestamptz(3)
  eraseAfter            DateTime? @db.Timestamptz(3)
  completedAt           DateTime? @db.Timestamptz(3)
  evidenceExpiresAt     DateTime? @db.Timestamptz(3)

  @@index([ownerUserId, createdAt, id])
  @@index([state, nextAt, id])
  evidenceKeyId String? @db.VarChar(40)

}

model SyncChange {
  id         String   @id @default(uuid()) @db.Uuid
  spaceId    String   @db.Uuid
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sequence   BigInt
  entity     String   @db.VarChar(20)
  resourceId String   @db.Uuid
  parentId   String?  @db.Uuid
  revision   Int
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([spaceId, sequence])
  @@index([spaceId, createdAt, sequence])
  @@index([createdAt, spaceId, sequence])
}

model SyncMutationReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  spaceId          String   @db.Uuid
  actorUserId      String   @db.Uuid
  space            Space    @relation(fields: [spaceId, actorUserId], references: [id, ownerUserId], onDelete: Cascade)
  clientMutationId String   @db.Uuid
  clientEntryId    String?  @db.Uuid
  fingerprint      String   @db.Char(64)
  disposition      String   @db.VarChar(12)
  resourceId       String?  @db.Uuid
  result           Json?    @db.JsonB
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  bodyExpiresAt    DateTime @db.Timestamptz(3)

  @@unique([spaceId, clientMutationId])
  @@unique([spaceId, clientEntryId])
  @@index([spaceId, bodyExpiresAt, id])
  @@index([bodyExpiresAt, id])
}

model AchievementUnlock {
  id           String                @id @default(uuid()) @db.Uuid
  spaceId      String                @db.Uuid
  space        Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  definitionId String                @db.Uuid
  definition   AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  ruleVersion  Int                   @default(1)
  unlockedAt   DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([spaceId, definitionId])
}

model XpLedger {
  id            String      @id @default(uuid()) @db.Uuid
  spaceId       String      @db.Uuid
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sourceEventId String      @unique @db.Uuid
  sourceEvent   OutboxEvent @relation(fields: [spaceId, sourceEventId], references: [spaceId, id], onDelete: Cascade)
  rewardKey     String      @db.VarChar(100)
  kind          String      @db.VarChar(20)
  points        Int
  ruleVersion   Int         @default(1)
  earnedAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([spaceId, rewardKey])
  @@unique([spaceId, sourceEventId])
  @@index([spaceId, earnedAt, id])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  spaceId     String   @db.Uuid
  space       Space    @relation(fields: [spaceId, actorUserId], references: [id, ownerUserId], onDelete: Cascade)
  operation   String   @db.VarChar(80)
  keyHash     String   @db.Char(64)
  fingerprint String   @db.Char(64)
  resultId    String   @db.Uuid
  statusCode  Int
  result      Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([actorUserId, spaceId, operation, keyHash])
  @@index([expiresAt])
}

enum StoredFileStatus {
  INITIATED
  READY
  REJECTED
  DELETED
}

model StoredFile {
  id                              String           @id @default(uuid()) @db.Uuid
  spaceId                         String           @db.Uuid
  ownerUserId                     String?          @db.Uuid
  objectKey                       String           @unique @db.Uuid
  filename                        String           @db.VarChar(180)
  mimeType                        String           @db.VarChar(100)
  expectedSize                    Int
  expectedSha256                  String?          @db.Char(64)
  actualSize                      Int?
  sha256                          String?          @db.Char(64)
  status                          StoredFileStatus @default(INITIATED)
  revision                        Int              @default(1)
  uploadAttemptId                 String?          @db.Uuid
  uploadStartedAt                 DateTime?        @db.Timestamptz(3)
  uploadExpiresAt                 DateTime         @db.Timestamptz(3)
  createdAt                       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime         @updatedAt @db.Timestamptz(3)
  completedAt                     DateTime?        @db.Timestamptz(3)
  deletedAt                       DateTime?        @db.Timestamptz(3)
  purgedAt                        DateTime?        @db.Timestamptz(3)
  scopeId                         String?          @db.Uuid
  createdByActorId                String?          @db.Uuid
  voiceCaptures                   CaptureItem[]
  ProjectFile                     ProjectFile[]
  Space_StoredFile_spaceIdToSpace Space            @relation("StoredFile_spaceIdToSpace", fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "StoredFile_direct_space_fk")
  AccessScope                     AccessScope?     @relation(fields: [spaceId, scopeId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "StoredFile_scope_fk")
  SharedActor                     SharedActor?     @relation(fields: [spaceId, createdByActorId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "StoredFile_shared_actor_fk")
  space                           Space?           @relation(fields: [spaceId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  taskAttachments                 TaskAttachment[]

  @@unique([spaceId, id])
  @@unique([spaceId, scopeId, id], map: "StoredFile_scope_id_key")
  @@index([spaceId, status, createdAt, id])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  reminders          Reminder[]
  noteReferences     Note[]
  captureTargets     CaptureItem[]
  estimatedMinutes   Int?
  important          Boolean?
  urgent             Boolean?
  focusSessions      FocusSession[]
  timeEntries        TimeEntry[]
  goalLinks          GoalTaskLink[]
  id                 String              @id @default(uuid()) @db.Uuid
  spaceId            String              @db.Uuid
  space              Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId    String?             @db.Uuid
  creator            User?               @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: NoAction)
  title              String              @db.VarChar(300)
  descriptionContent String?
  descriptionFormat  String              @default("MARKDOWN") @db.VarChar(20)
  descriptionVersion Int                 @default(1)
  status             TaskStatus          @default(OPEN)
  priority           TaskPriority        @default(NONE)
  parentTaskId       String?             @db.Uuid
  parent             Task?               @relation("TaskTree", fields: [spaceId, parentTaskId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  subtasks           Task[]              @relation("TaskTree")
  plannedStartAt     DateTime?           @db.Timestamptz(3)
  dueAt              DateTime?           @db.Timestamptz(3)
  scheduledDate      DateTime?           @db.Date
  completedAt        DateTime?           @db.Timestamptz(3)
  revision           Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  deletionBatchId    String?             @db.Uuid
  checklistItems     TaskChecklistItem[]
  labels             TaskLabel[]
  attachments        TaskAttachment[]
  changes            TaskChange[]
  masterRecurrence   TaskRecurrence?     @relation("RecurrenceMaster")
  occurrence         TaskOccurrence?     @relation("OccurrenceTask")
  dailyPlanItems     DailyPlanItem[]
  timeBlocks         TimeBlock[]

  scopeId                                            String?       @db.Uuid
  createdByActorId                                   String?       @db.Uuid
  ProjectTask                                        ProjectTask[]
  Task_Task_spaceId_scopeId_parentTaskIdToTask       Task?         @relation("Task_spaceId_scopeId_parentTaskIdToTask", fields: [spaceId, scopeId, parentTaskId], references: [spaceId, scopeId, id], onDelete: NoAction, onUpdate: NoAction, map: "Task_parent_scope_fk")
  other_Task_Task_spaceId_scopeId_parentTaskIdToTask Task[]        @relation("Task_spaceId_scopeId_parentTaskIdToTask")
  AccessScope                                        AccessScope?  @relation(fields: [spaceId, scopeId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "Task_scope_fk")
  SharedActor                                        SharedActor?  @relation(fields: [spaceId, createdByActorId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "Task_shared_actor_fk")
  TaskChange_TaskChange_spaceId_scopeId_taskIdToTask TaskChange[]  @relation("TaskChange_spaceId_scopeId_taskIdToTask")
  TaskGrant                                          TaskGrant[]

  ResourceGrantOffer ResourceGrantOffer[]

  TimeBlockSharedTaskLink TimeBlockSharedTaskLink[]

  TaskDependency_TaskDependency_spaceId_scopeId_predecessorIdToTask TaskDependency[]       @relation("TaskDependency_spaceId_scopeId_predecessorIdToTask")
  TaskDependency_TaskDependency_spaceId_scopeId_successorIdToTask   TaskDependency[]       @relation("TaskDependency_spaceId_scopeId_successorIdToTask")
  TaskFieldValue                                                    TaskFieldValue[]
  TaskMetadataEvent                                                 TaskMetadataEvent[]
  TaskRescheduleItem                                                TaskRescheduleItem[]
  TaskWorkflowApproval                                              TaskWorkflowApproval[]
  TaskWorkflowBinding                                               TaskWorkflowBinding[]

  SharedTaskWorkLog SharedTaskWorkLog[]

  @@unique([spaceId, id])
  @@unique([spaceId, scopeId, id], map: "Task_scope_id_key")
  @@index([spaceId, deletedAt, createdAt, id])
  @@index([spaceId, parentTaskId, deletedAt, createdAt, id])
  @@index([spaceId, status, deletedAt, createdAt, id])
  @@index([spaceId, dueAt])
}

model TaskChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  title     String   @db.VarChar(300)
  completed Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, taskId, position, id])
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  spaceId   String      @db.Uuid
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(100)
  revision  Int         @default(1)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  tasks     TaskLabel[]

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model TaskLabel {
  spaceId   String   @db.Uuid
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  task      Task     @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  label     Label    @relation(fields: [spaceId, labelId], references: [spaceId, id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([spaceId, taskId, labelId])
  @@index([spaceId, labelId, taskId])
}

model TaskAttachment {
  spaceId   String     @db.Uuid
  taskId    String     @db.Uuid
  fileId    String     @db.Uuid
  task      Task       @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  file      StoredFile @relation(fields: [spaceId, fileId], references: [spaceId, id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@id([spaceId, taskId, fileId])
  @@index([spaceId, taskId, createdAt, fileId])
}

model TaskChange {
  id               String        @id @default(uuid()) @db.Uuid
  spaceId          String        @db.Uuid
  taskId           String        @db.Uuid
  task             Task          @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  actorUserId      String?       @db.Uuid
  actor            User?         @relation("TaskActor", fields: [actorUserId], references: [id], onDelete: NoAction)
  kind             String        @db.VarChar(40)
  fields           String[]
  previousRevision Int
  revision         Int
  beforeStatus     TaskStatus?
  afterStatus      TaskStatus
  beforePriority   TaskPriority?
  afterPriority    TaskPriority
  relatedId        String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  scopeId                                      String?      @db.Uuid
  actorId                                      String?      @db.Uuid
  SharedActor                                  SharedActor? @relation(fields: [spaceId, actorId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "TaskChange_actor_fk")
  Task_TaskChange_spaceId_scopeId_taskIdToTask Task?        @relation("TaskChange_spaceId_scopeId_taskIdToTask", fields: [spaceId, scopeId, taskId], references: [spaceId, scopeId, id], onDelete: Cascade, onUpdate: NoAction, map: "TaskChange_scope_fk")

  @@unique([spaceId, taskId, revision])
  @@index([spaceId, taskId, revision, id])
}

model TaskTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  name            String   @db.VarChar(100)
  values          Json     @db.JsonB
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model SavedTaskFilter {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  name            String   @db.VarChar(100)
  query           Json     @db.JsonB
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model TaskRecurrence {
  id               String           @id @default(uuid()) @db.Uuid
  spaceId          String           @db.Uuid
  createdByUserId  String           @db.Uuid
  space            Space            @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  masterTaskId     String           @unique @db.Uuid
  master           Task             @relation("RecurrenceMaster", fields: [spaceId, masterTaskId], references: [spaceId, id], onDelete: Cascade)
