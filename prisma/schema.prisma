generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth scalar fields generated by auth@1.7.14 from authSchemaOptions.
model User {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authsessions  AuthSession[]
  authaccounts  AuthAccount[]
  settings      UserSettings?
  spaces        Space[]

  @@unique([email])
  @@map("User")
}

model AuthSession {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("AuthAccount")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AuthVerification")
}

// Application-owned models. No business-domain or future batch tables.
model UserSettings {
  userId            String   @id @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale            String   @default("en")
  timezone          String   @default("UTC")
  preferredCalendar String   @default("GREGORIAN")
  firstDayOfWeek    Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum SpaceKind {
  PERSONAL
}

model Space {
  id          String    @id @default(uuid()) @db.Uuid
  kind        SpaceKind @default(PERSONAL)
  ownerUserId String    @db.Uuid
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, ownerUserId])
}
