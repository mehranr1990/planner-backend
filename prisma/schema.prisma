generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Auth scalar fields generated by auth@1.7.14 from authSchemaOptions.
model User {
  id                  String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                String
  email               String
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  authsessions        AuthSession[]
  authaccounts        AuthAccount[]
  settings            UserSettings?
  spaces              Space[]
  securityAuditEvents SecurityAuditEvent[]
  createdTasks        Task[]               @relation("TaskCreator")
  taskChanges         TaskChange[]         @relation("TaskActor")

  @@unique([email])
  @@map("User")
}

model AuthSession {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model AuthAccount {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("AuthAccount")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("AuthVerification")
}

// Application-owned account foundation; business models are added only in their approved batches.
model UserSettings {
  userId               String   @id @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale               String   @default("en")
  timezone             String   @default("UTC")
  preferredCalendar    String   @default("GREGORIAN")
  firstDayOfWeek       Int      @default(1)
  planningAvailability Json?    @db.JsonB
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum SpaceKind {
  PERSONAL
}

model Space {
  notes              Note[]
  noteFolders        NoteFolder[]
  journalEntries     JournalEntry[]
  moodEntries        MoodEntry[]
  captureItems       CaptureItem[]
  focusSessions      FocusSession[]
  timeEntries        TimeEntry[]
  id                 String              @id @default(uuid()) @db.Uuid
  kind               SpaceKind           @default(PERSONAL)
  ownerUserId        String              @db.Uuid
  owner              User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outboxEvents       OutboxEvent[]
  idempotencyRecords IdempotencyRecord[]
  storedFiles        StoredFile[]
  tasks              Task[]
  labels             Label[]
  taskTemplates      TaskTemplate[]
  savedTaskFilters   SavedTaskFilter[]
  taskRecurrences    TaskRecurrence[]
  dailyPlans         DailyPlan[]
  weeklyPlans        WeeklyPlan[]
  planningReviews    PlanningReview[]
  calendarEvents     CalendarEvent[]
  eventRecurrences   EventRecurrence[]
  timeBlocks         TimeBlock[]
  habits             Habit[]
  habitEntryActors   HabitEntry[]
  routines           Routine[]
  lifeAreas          LifeArea[]
  goals              Goal[]

  @@unique([kind, ownerUserId])
  @@unique([id, ownerUserId])
}

// Platform evidence: deliberately contains no email, IP, token, URL or arbitrary JSON.
enum AuditOutcome {
  ATTEMPTED
  SUCCEEDED
  DENIED
  FAILED
}

model SecurityAuditEvent {
  productivityFields String[]     @default([])
  id                 String       @id @default(uuid()) @db.Uuid
  action             String       @db.VarChar(40)
  outcome            AuditOutcome
  actorUserId        String?      @db.Uuid
  actor              User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  requestId          String       @db.Uuid
  correlationId      String       @db.Uuid
  resourceId         String?      @db.Uuid
  changedFields      String[]     @default([])
  occurredAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, occurredAt, id])
  @@index([requestId])
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  type          String   @db.VarChar(100)
  version       Int
  occurredAt    DateTime @default(now()) @db.Timestamptz(3)
  aggregateId   String   @db.Uuid
  spaceId       String   @db.Uuid
  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  payload       Json     @db.JsonB
  correlationId String   @db.Uuid

  @@index([spaceId, occurredAt, id])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  spaceId     String   @db.Uuid
  space       Space    @relation(fields: [spaceId, actorUserId], references: [id, ownerUserId], onDelete: Cascade)
  operation   String   @db.VarChar(80)
  keyHash     String   @db.Char(64)
  fingerprint String   @db.Char(64)
  resultId    String   @db.Uuid
  statusCode  Int
  result      Json?    @db.JsonB
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([actorUserId, spaceId, operation, keyHash])
  @@index([expiresAt])
}

enum StoredFileStatus {
  INITIATED
  READY
  REJECTED
  DELETED
}

model StoredFile {
  voiceCaptures   CaptureItem[]
  id              String           @id @default(uuid()) @db.Uuid
  spaceId         String           @db.Uuid
  ownerUserId     String           @db.Uuid
  space           Space            @relation(fields: [spaceId, ownerUserId], references: [id, ownerUserId], onDelete: Cascade)
  objectKey       String           @unique @db.Uuid
  filename        String           @db.VarChar(180)
  mimeType        String           @db.VarChar(100)
  expectedSize    Int
  expectedSha256  String?          @db.Char(64)
  actualSize      Int?
  sha256          String?          @db.Char(64)
  status          StoredFileStatus @default(INITIATED)
  revision        Int              @default(1)
  uploadAttemptId String?          @db.Uuid
  uploadStartedAt DateTime?        @db.Timestamptz(3)
  uploadExpiresAt DateTime         @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  purgedAt        DateTime?        @db.Timestamptz(3)
  taskAttachments TaskAttachment[]

  @@unique([spaceId, id])
  @@index([spaceId, status, createdAt, id])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  noteReferences     Note[]
  captureTargets     CaptureItem[]
  estimatedMinutes   Int?
  important          Boolean?
  urgent             Boolean?
  focusSessions      FocusSession[]
  timeEntries        TimeEntry[]
  goalLinks          GoalTaskLink[]
  id                 String              @id @default(uuid()) @db.Uuid
  spaceId            String              @db.Uuid
  space              Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId    String              @db.Uuid
  creator            User                @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: NoAction)
  title              String              @db.VarChar(300)
  descriptionContent String?
  descriptionFormat  String              @default("MARKDOWN") @db.VarChar(20)
  descriptionVersion Int                 @default(1)
  status             TaskStatus          @default(OPEN)
  priority           TaskPriority        @default(NONE)
  parentTaskId       String?             @db.Uuid
  parent             Task?               @relation("TaskTree", fields: [spaceId, parentTaskId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  subtasks           Task[]              @relation("TaskTree")
  plannedStartAt     DateTime?           @db.Timestamptz(3)
  dueAt              DateTime?           @db.Timestamptz(3)
  scheduledDate      DateTime?           @db.Date
  completedAt        DateTime?           @db.Timestamptz(3)
  revision           Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  deletionBatchId    String?             @db.Uuid
  checklistItems     TaskChecklistItem[]
  labels             TaskLabel[]
  attachments        TaskAttachment[]
  changes            TaskChange[]
  masterRecurrence   TaskRecurrence?     @relation("RecurrenceMaster")
  occurrence         TaskOccurrence?     @relation("OccurrenceTask")
  dailyPlanItems     DailyPlanItem[]
  timeBlocks         TimeBlock[]

  @@unique([spaceId, id])
  @@index([spaceId, deletedAt, createdAt, id])
  @@index([spaceId, parentTaskId, deletedAt, createdAt, id])
  @@index([spaceId, status, deletedAt, createdAt, id])
  @@index([spaceId, dueAt])
}

model TaskChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  title     String   @db.VarChar(300)
  completed Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, taskId, position, id])
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  spaceId   String      @db.Uuid
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(100)
  revision  Int         @default(1)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  tasks     TaskLabel[]

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model TaskLabel {
  spaceId   String   @db.Uuid
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  task      Task     @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  label     Label    @relation(fields: [spaceId, labelId], references: [spaceId, id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([spaceId, taskId, labelId])
  @@index([spaceId, labelId, taskId])
}

model TaskAttachment {
  spaceId   String     @db.Uuid
  taskId    String     @db.Uuid
  fileId    String     @db.Uuid
  task      Task       @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  file      StoredFile @relation(fields: [spaceId, fileId], references: [spaceId, id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@id([spaceId, taskId, fileId])
  @@index([spaceId, taskId, createdAt, fileId])
}

model TaskChange {
  id               String        @id @default(uuid()) @db.Uuid
  spaceId          String        @db.Uuid
  taskId           String        @db.Uuid
  task             Task          @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  actorUserId      String        @db.Uuid
  actor            User          @relation("TaskActor", fields: [actorUserId], references: [id], onDelete: NoAction)
  kind             String        @db.VarChar(40)
  fields           String[]
  previousRevision Int
  revision         Int
  beforeStatus     TaskStatus?
  afterStatus      TaskStatus
  beforePriority   TaskPriority?
  afterPriority    TaskPriority
  relatedId        String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([spaceId, taskId, revision])
  @@index([spaceId, taskId, revision, id])
}

model TaskTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  name            String   @db.VarChar(100)
  values          Json     @db.JsonB
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model SavedTaskFilter {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  name            String   @db.VarChar(100)
  query           Json     @db.JsonB
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@index([spaceId, createdAt, id])
}

model TaskRecurrence {
  id               String           @id @default(uuid()) @db.Uuid
  spaceId          String           @db.Uuid
  createdByUserId  String           @db.Uuid
  space            Space            @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  masterTaskId     String           @unique @db.Uuid
  master           Task             @relation("RecurrenceMaster", fields: [spaceId, masterTaskId], references: [spaceId, id], onDelete: Cascade)
  previousSeriesId String?          @unique @db.Uuid
  previous         TaskRecurrence?  @relation("SeriesLineage", fields: [spaceId, previousSeriesId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  successor        TaskRecurrence?  @relation("SeriesLineage")
  definition       Json             @db.JsonB
  identityTime     String           @db.VarChar(5)
  splitBefore      DateTime?        @db.Date
  gapPolicy        String           @default("SKIP_WITH_REASON") @db.VarChar(30)
  foldPolicy       String           @default("EARLIER") @db.VarChar(20)
  shortMonthPolicy String           @default("SKIP") @db.VarChar(20)
  leapDayPolicy    String           @default("SKIP") @db.VarChar(20)
  revision         Int              @default(1)
  scannedThrough   DateTime?        @db.Date
  retiredAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  occurrences      TaskOccurrence[]

  @@unique([spaceId, id])
  @@unique([spaceId, masterTaskId])
  @@unique([spaceId, previousSeriesId])
  @@index([spaceId, createdAt, id])
}

model TaskOccurrence {
  id            String         @id @default(uuid()) @db.Uuid
  spaceId       String         @db.Uuid
  seriesId      String         @db.Uuid
  series        TaskRecurrence @relation(fields: [spaceId, seriesId], references: [spaceId, id], onDelete: Cascade)
  taskId        String?        @unique @db.Uuid
  task          Task?          @relation("OccurrenceTask", fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  recurrenceKey String         @db.VarChar(19)
  localDate     DateTime       @db.Date
  localTime     String         @db.VarChar(5)
  timezone      String         @db.VarChar(100)
  scheduledAt   DateTime?      @db.Timestamptz(3)
  state         String         @default("PENDING") @db.VarChar(20)
  reason        String?        @db.VarChar(30)
  exception     Boolean        @default(false)
  revision      Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, id])
  @@unique([spaceId, taskId])
  @@unique([seriesId, recurrenceKey])
  @@index([spaceId, seriesId, createdAt, id])
  @@index([spaceId, state, localDate, id])
}

model DailyPlan {
  id              String          @id @default(uuid()) @db.Uuid
  spaceId         String          @db.Uuid
  createdByUserId String          @db.Uuid
  space           Space           @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  localDate       DateTime        @db.Date
  timezone        String          @db.VarChar(100)
  revision        Int             @default(1)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  items           DailyPlanItem[]

  @@unique([spaceId, localDate])
  @@unique([spaceId, id, localDate])
}

model DailyPlanItem {
  id                   String    @id @default(uuid()) @db.Uuid
  spaceId              String    @db.Uuid
  planId               String    @db.Uuid
  localDate            DateTime  @db.Date
  plan                 DailyPlan @relation(fields: [spaceId, planId, localDate], references: [spaceId, id, localDate], onDelete: Cascade)
  taskId               String    @db.Uuid
  task                 Task      @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: Cascade)
  position             Int
  plannedMinutes       Int?
  selectedTaskRevision Int
  revision             Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, localDate, taskId])
  @@unique([spaceId, planId, position])
  @@index([spaceId, taskId])
}

model WeeklyPlan {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  weekStartDate   DateTime @db.Date
  timezone        String   @db.VarChar(100)
  firstDayOfWeek  Int
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, weekStartDate])
}

model PlanningReview {
  id              String   @id @default(uuid()) @db.Uuid
  spaceId         String   @db.Uuid
  createdByUserId String   @db.Uuid
  space           Space    @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  localDate       DateTime @db.Date
  kind            String   @db.VarChar(10)
  timezone        String   @db.VarChar(100)
  firstDayOfWeek  Int
  reflection      String
  revision        Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([spaceId, localDate, kind])
  @@index([spaceId, createdAt, id])
}

model CalendarEvent {
  id               String            @id @default(uuid()) @db.Uuid
  spaceId          String            @db.Uuid
  createdByUserId  String            @db.Uuid
  title            String            @db.VarChar(300)
  status           String            @default("ACTIVE") @db.VarChar(10)
  kind             String            @db.VarChar(10)
  timezone         String            @db.VarChar(100)
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  localStart       String?           @db.VarChar(16)
  localEnd         String?           @db.VarChar(16)
  startAt          DateTime?         @db.Timestamptz(3)
  endAt            DateTime?         @db.Timestamptz(3)
  revision         Int               @default(1)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  space            Space             @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  description      String?
  deletedAt        DateTime?         @db.Timestamptz(3)
  seriesId         String?           @db.Uuid
  recurrenceKey    String?           @db.VarChar(16)
  series           CalendarEvent?    @relation("EventExceptions", fields: [spaceId, seriesId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  exceptions       CalendarEvent[]   @relation("EventExceptions")
  previousSeriesId String?           @db.Uuid
  previous         CalendarEvent?    @relation("EventLineage", fields: [spaceId, previousSeriesId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  successors       CalendarEvent[]   @relation("EventLineage")
  splitBefore      String?           @db.VarChar(16)
  versions         EventRecurrence[]

  @@unique([spaceId, id])
  @@unique([seriesId, recurrenceKey])
  @@unique([spaceId, previousSeriesId])
  @@index([spaceId, seriesId, deletedAt, createdAt, id])
  @@index([spaceId, startAt, endAt])
  @@index([spaceId, startDate, endDate])
}

model EventRecurrence {
  space           Space         @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  id              String        @id @default(uuid()) @db.Uuid
  spaceId         String        @db.Uuid
  createdByUserId String        @db.Uuid
  title           String        @db.VarChar(300)
  status          String        @default("ACTIVE") @db.VarChar(10)
  kind            String        @db.VarChar(10)
  timezone        String        @db.VarChar(100)
  startDate       DateTime?     @db.Date
  endDate         DateTime?     @db.Date
  localStart      String?       @db.VarChar(16)
  localEnd        String?       @db.VarChar(16)
  startAt         DateTime?     @db.Timestamptz(3)
  endAt           DateTime?     @db.Timestamptz(3)
  revision        Int           @default(1)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  eventId         String        @db.Uuid
  event           CalendarEvent @relation(fields: [spaceId, eventId], references: [spaceId, id], onDelete: Cascade)
  description     String?
  definition      Json          @db.JsonB
  identityTime    String        @db.VarChar(5)
  fromKey         String        @db.VarChar(16)
  untilKey        String?       @db.VarChar(16)

  @@unique([spaceId, id])
  @@unique([eventId, revision])
  @@index([spaceId, eventId, fromKey, untilKey])
}

model TimeBlock {
  id                   String    @id @default(uuid()) @db.Uuid
  spaceId              String    @db.Uuid
  createdByUserId      String    @db.Uuid
  title                String    @db.VarChar(300)
  status               String    @default("ACTIVE") @db.VarChar(10)
  kind                 String    @db.VarChar(10)
  timezone             String    @db.VarChar(100)
  startDate            DateTime? @db.Date
  endDate              DateTime? @db.Date
  localStart           String?   @db.VarChar(16)
  localEnd             String?   @db.VarChar(16)
  startAt              DateTime? @db.Timestamptz(3)
  endAt                DateTime? @db.Timestamptz(3)
  revision             Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  space                Space     @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  deletedAt            DateTime? @db.Timestamptz(3)
  taskId               String?   @db.Uuid
  task                 Task?     @relation(fields: [spaceId, taskId], references: [spaceId, id], onDelete: NoAction, onUpdate: NoAction)
  selectedTaskRevision Int?

  @@unique([spaceId, id])
  @@index([spaceId, deletedAt, createdAt, id])
  @@index([spaceId, startAt, endAt])
  @@index([spaceId, taskId])
}

model Habit {
  captureTargets  CaptureItem[]
  goalLinks       GoalHabitLink[]
  id              String          @id @default(uuid()) @db.Uuid
  spaceId         String          @db.Uuid
  createdByUserId String          @db.Uuid
  space           Space           @relation(fields: [spaceId, createdByUserId], references: [id, ownerUserId], onDelete: Cascade)
  title           String          @db.VarChar(300)
  type            String          @db.VarChar(10)
  unit            String          @db.VarChar(30)
  purpose         String          @default("GENERIC") @db.VarChar(10)
  revision        Int             @default(1)
