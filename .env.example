NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DB_HEALTH_TIMEOUT_MS=2000
# Provision this database locally. This placeholder is not a real credential.
DATABASE_URL=postgresql://postgres:REPLACE_ME@localhost:5432/mehran_dev
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=http://127.0.0.1:3000
MAIL_MODE=sink
MAIL_SINK_DIR=.tools/mail
MAIL_FROM=no-reply@localhost.invalid
STORAGE_ROOT=.tools/private-files
# P1-12: initialize this independent control root once for a NEW installation.
# Never overwrite/reinitialize it during restore; preserve verification secrets.
ERASURE_CONTROL_ROOT=.tools/private-files-erasure-control
# Set only after the deployment owner confirms personal-record legal retention.
# PERSONAL_ERASURE_POLICY_VERSION=personal-v1
FILE_MAX_BYTES=10485760
FILE_UPLOAD_TIMEOUT_MS=120000
FILE_UPLOAD_TTL_SECONDS=3600
FILE_LINK_TTL_SECONDS=300
# Production additionally requires HTTPS origins and SMTP_HOST/PORT/USER/PASSWORD.
# P1-10: install this reviewed queue schema once with pnpm jobs:migrate.
JOBS_SCHEMA=planner_jobs
JOBS_POLL_SECONDS=1
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SINK_DIR=.tools/notifications
PUSH_MODE=disabled
# Optional webpush mode requires PUSH_VAPID_PUBLIC_KEY, PUSH_VAPID_PRIVATE_KEY,
# PUSH_VAPID_SUBJECT (mailto/HTTPS). Generate/provision privately; never commit keys.
