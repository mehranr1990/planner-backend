{
  "name": "mehran-planner",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "dev": "pnpm --filter @mehran/api-contracts build && pnpm --filter @mehran/api dev",
    "start": "node --env-file=.env apps/api/dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @mehran/api-contracts build && tsc --noEmit",
    "architecture": "depcruise apps/api/src packages/api-contracts/src --config tooling/architecture-tests/dependency-cruiser.mjs",
    "test": "vitest run --project unit --project contract --project architecture --project compatibility",
    "test:unit": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run --project integration",
    "test:watch": "vitest --project unit",
    "compatibility": "vitest run --project compatibility",
    "config:check": "node --env-file-if-exists=.env tooling/scripts/config-check.ts",
    "db:check": "node --env-file-if-exists=.env tooling/scripts/db-check.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:migrate:deploy": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts",
    "openapi:generate": "node tooling/scripts/openapi.ts --write",
    "openapi:check": "node tooling/scripts/openapi.ts --check",
    "quality": "node tooling/scripts/quality.ts",
    "auth:schema:check": "node tooling/scripts/auth-schema-check.ts",
    "db:migrations:check": "node --env-file-if-exists=.env.test.local tooling/scripts/migrations-check.ts",
    "smoke:p1-02": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-02-smoke.ts",
    "smoke:p1-03": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-03-smoke.ts",
    "smoke:p1-04": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-04-smoke.ts",
    "smoke:p1-05": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-05-smoke.ts",
    "smoke:p1-06": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-06-smoke.ts",
    "smoke:p1-07": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-07-smoke.ts",
    "smoke:p1-08": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-08-smoke.ts",
    "smoke:p1-09": "node --env-file-if-exists=.env.test.local tooling/scripts/p1-09-smoke.ts"
  },
  "devDependencies": {
    "@nestjs/throttler": "6.7.1",
    "pg": "8.23.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "better-auth": "1.7.14",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "@nestjs/common": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/core": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "auth": "1.7.14",
    "@types/nodemailer": "8.0.2"
  }
}
