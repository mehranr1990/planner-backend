# Docker Compose deployment template. Copy OUTSIDE the repository (Windows:
# %LOCALAPPDATA%\mehran-planner\planner.env; Linux: /etc/mehran-planner/planner.env,
# mode 600) and replace every REPLACE_* value.
# Never commit the real file. Generation commands: docs/deployment/docker-deployment.md.
# Commented (#NAME=) settings are optional: uncomment only with a real value,
# because an empty value fails configuration validation.

# --- Access: HTTPS only via Nginx Proxy Manager (NPM) ---
# Windows Docker Desktop: keep 127.0.0.1 / https://planner.localhost (local-only).
# Never plain "localhost" or a bare IP: NPM reserves them for its rejecting catch-all.
# Linux server: PROXY_BIND=<private/VPN IP> and https://<private hostname resolving to it>.
PROXY_BIND=127.0.0.1
PROXY_HTTPS_PORT=443
# NPM admin UI is always bound to 127.0.0.1 on this port.
NPM_ADMIN_PORT=81
# Optional LAN listener (compose.lan.yaml, HTTPS only): the host LAN IP. Add the LAN
# origin (e.g. https://planner.home.arpa) to CORS_ORIGINS and restrict the firewall.
#PROXY_LAN_BIND=
# Same origin: browser app and API share this exact origin (no port when 443).
BETTER_AUTH_URL=https://planner.localhost
CORS_ORIGINS=https://planner.localhost
# Frontend checkout, relative to this repository (side-by-side clone).
FRONTEND_CONTEXT=../planner

# --- PostgreSQL 18 (dedicated Docker database; never a host database) ---
POSTGRES_USER=planner
POSTGRES_DB=mehran
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
DOCKER_DATABASE_URL=postgresql://planner:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@postgres:5432/mehran

# --- Authentication ---
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LOG_LEVEL=info

# --- Email (production mode requires SMTP; sink mode is rejected) ---
# Resend SMTP: MAIL_FROM must be a plain address on a Resend-verified domain.
# Until a domain is verified, use onboarding@resend.dev, which Resend delivers
# only to the Resend account owner's own address.
# Port 465 = implicit TLS; 587 = enforced STARTTLS. Outbound TCP 465/587 must be open.
MAIL_FROM=no-reply@example.invalid
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_API_KEY
NOTIFICATION_EMAIL_ENABLED=false

# --- Files (ClamAV overlay is always applied by the deploy/planner-compose wrappers) ---
FILE_MAX_BYTES=10485760
FILE_UPLOAD_TIMEOUT_MS=120000
FILE_UPLOAD_TTL_SECONDS=3600
FILE_LINK_TTL_SECONDS=300
# ADR 0068: scanner host/port come from compose.clamav.yaml.
MALWARE_SCAN_TIMEOUT_MS=30000
MALWARE_SCAN_MAX_BYTES=67108864
MALWARE_SIGNATURE_MAX_AGE_HOURS=48

# --- Browser push (needs a client-trusted HTTPS origin) ---
# disabled | webpush. "sink" is forbidden in production.
PUSH_MODE=disabled
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:REPLACE_WITH_OPERATOR_ADDRESS

# --- Personal evidence keyring (recommended from first start; single-quoted JSON) ---
# Four distinct values per key ID; none may equal BETTER_AUTH_SECRET.
#PERSONAL_EVIDENCE_KEYS=
#PERSONAL_EVIDENCE_ACTIVE_KEY_ID=
# Owner-approved Personal erasure policy version. Unset = account deletion
# stays unavailable (ERASURE_POLICY_UNAVAILABLE). Also baked into the web build.
#PERSONAL_ERASURE_POLICY_VERSION=

# --- Shared (Company/Team/Project/Social) activation: gated by default ---
# Signing keys for the independent shared control root (single-quoted JSON).
#SHARED_CONTROL_KEYS=
#SHARED_CONTROL_ACTIVE_KEY_ID=
# Only the owner's genuine security acceptance reference. Never invent one.
# Unset = Shared features answer SHARED_ACTIVATION_GATED.
#SHARED_SECURITY_ACCEPTANCE_REFERENCE=
